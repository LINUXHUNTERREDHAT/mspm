#!/bin/sh

REPOS_BASE_DIR="/etc/mspm/repos"
REPOS_CONF="/etc/mspm/repos.conf"
CACHE_BASE_DIR="/etc/mspm/cache"
INSTALLED_FILE="/etc/mspm/installed"
MAKECONF_FILE="/etc/mspm/make.conf"

CLR_RESET="\033[0m"
CLR_RED="\033[1;31m"
CLR_GREEN="\033[1;32m"
CLR_YELLOW="\033[1;33m"
CLR_BLUE="\033[1;34m"
CLR_CYAN="\033[1;36m"

is_function() {
    type "$1" 2>/dev/null | grep -q "function"
}

load_make_conf() {
    if [ -f "$MAKECONF_FILE" ]; then
        set -a
        . "$MAKECONF_FILE"
        set +a
    fi
}

get_ordered_repos() {
    if [ -f "$REPOS_CONF" ]; then
        grep -v '^[[:space:]]*#' "$REPOS_CONF" | grep -v '^[[:space:]]*$' | cut -d'=' -f1
    fi
}

find_package() {
    target="$1"
    
    case "$target" in
        *::*)
            pkg_name="${target%%::*}"
            repo_name="${target##*::}"
            if [ -f "${REPOS_BASE_DIR}/${repo_name}/${pkg_name}/mspm-build" ]; then
                echo "$repo_name"
                return 0
            fi
            return 1
            ;;
    esac

    for repo in $(get_ordered_repos); do
        if [ -n "$repo" ] && [ -f "${REPOS_BASE_DIR}/${repo}/${target}/mspm-build" ]; then
            echo "$repo"
            return 0
        fi
    done
    return 1
}

is_package_installed() {
    target="$1"
    [ -f "$INSTALLED_FILE" ] && grep -qE "^${target}::" "$INSTALLED_FILE"
}

get_installed_package_entry() {
    pkg_name="$1"
    if [ -f "$INSTALLED_FILE" ]; then
        grep -E "^${pkg_name}::" "$INSTALLED_FILE" | head -n 1
    fi
}

register_package() {
    pkg_name="$1"
    repo_name="$2"
    version="$3"
    full_spec="${pkg_name}::${repo_name}::${version}"
    
    mkdir -p "$(dirname "$INSTALLED_FILE")"
    touch "$INSTALLED_FILE"
    unregister_package "$pkg_name"
    echo "$full_spec" >> "$INSTALLED_FILE"
}

unregister_package() {
    pkg_name="$1"
    if [ -f "$INSTALLED_FILE" ]; then
        sed "/^${pkg_name}::/d" "$INSTALLED_FILE" > "${INSTALLED_FILE}.tmp" && mv "${INSTALLED_FILE}.tmp" "$INSTALLED_FILE"
    fi
}

get_repo_version() {
    pkg="$1"
    repo="$2"
    script="${REPOS_BASE_DIR}/${repo}/${pkg}/mspm-build"
    version=""
    if [ -f "$script" ]; then
        version=$(version="" && . "$script" >/dev/null 2>&1 && echo "$version")
    fi
    echo "$version"
}

check_dependencies() {
    missing=""
    
    if [ -n "$depends" ]; then
        for dep in $depends; do
            if [ -n "$dep" ]; then
                satisfied=0
                clean_dep=$(echo "$dep" | sed 's/||/|/g')
                
                OLD_IFS="$IFS"
                IFS='|'
                for alt in $clean_dep; do
                    IFS="$OLD_IFS"
                    alt=$(echo "$alt" | xargs)
                    if [ -n "$alt" ]; then
                        if is_package_installed "$alt" || [ -n "$(get_installed_package_entry "$alt")" ]; then
                            satisfied=1
                            break
                        fi
                    fi
                done
                IFS="$OLD_IFS"

                if [ $satisfied -eq 0 ]; then
                    missing="${missing}${missing:+ }$dep"
                fi
            fi
        done
    fi

    if [ -n "$missing" ]; then
        printf "%b\n" "${CLR_RED}Error:${CLR_RESET} missing dependencies: ${CLR_CYAN}${missing}${CLR_RESET}"
        return 1
    fi

    return 0
}

prepare_build_script() {
    package="$1"
    repo="$2"
    work_dir="${CACHE_BASE_DIR}/${repo}/${package}"
    repo_script="${REPOS_BASE_DIR}/${repo}/${package}/mspm-build"
    target_script="${work_dir}/mspm-build"
    
    if [ ! -f "$repo_script" ]; then
        printf "%b\n" "${CLR_RED}Error:${CLR_RESET} build script for ${CLR_CYAN}${package}${CLR_RESET} not found in repository ${CLR_YELLOW}${repo}${CLR_RESET}."
        return 1
    fi

    mkdir -p "$work_dir"
    cp "$repo_script" "$target_script"
    cd "$work_dir" || exit 1
    return 0
}

sync_repo() {
    if [ ! -f "$REPOS_CONF" ]; then
        printf "%b\n" "${CLR_RED}Error:${CLR_RESET} ${REPOS_CONF} not found."
        exit 1
    fi

    mkdir -p "$REPOS_BASE_DIR"

    while IFS='=' read -r repo_name sync_cmd || [ -n "$repo_name" ]; do
        repo_name=$(echo "$repo_name" | xargs)
        sync_cmd=$(echo "$sync_cmd" | xargs)

        case "$repo_name" in
            \#*|"") continue ;;
        esac

        if [ -n "$repo_name" ] && [ -n "$sync_cmd" ]; then
            printf "%b\n" "Synchronizing repository: ${CLR_YELLOW}${repo_name}${CLR_RESET}..."
            repo_dir="${REPOS_BASE_DIR}/${repo_name}"
            
            rm -rf "$repo_dir"
            mkdir -p "$repo_dir"
            
            (cd "$repo_dir" && eval "$sync_cmd")
            if [ $? -eq 0 ]; then
                printf "%b\n" "${CLR_GREEN}Repository ${CLR_YELLOW}${repo_name}${CLR_GREEN} successfully synchronized.${CLR_RESET}"
            else
                printf "%b\n" "${CLR_RED}Error: failed to synchronize repository ${CLR_YELLOW}${repo_name}${CLR_RED}.${CLR_RESET}"
            fi
        fi
    done < "$REPOS_CONF"
}

process_install_list() {
    resolved=""

    for item in "$@"; do
        case "$item" in
            *::*)
                pkg="${item%%::*}"
                req_repo="${item##*::}"
                found_repo=$(find_package "${pkg}::${req_repo}")
                ;;
            *)
                pkg="$item"
                found_repo=$(find_package "$pkg")
                ;;
        esac

        if [ -n "$found_repo" ]; then
            resolved="${resolved}${resolved:+ }${pkg}::${found_repo}"
        else
            printf "%b\n" "${CLR_RED}Package not found in repository: ${CLR_CYAN}$item${CLR_RESET}"
            exit 1
        fi
    done

    if [ "${SKIP_CONFIRM}" != "1" ]; then
        printf "%b\n" "Packages to install:"
        for spec in $resolved; do
            pkg="${spec%%::*}"
            repo="${spec##*::}"
            ver=$(get_repo_version "$pkg" "$repo")
            printf "%b\n" "  - ${CLR_CYAN}${pkg}${CLR_RESET}${CLR_YELLOW}::${repo}${CLR_RESET} ${CLR_BLUE}(version: ${ver:-unknown})${CLR_RESET}"
        done
        echo

        printf "%b" "Proceed with installation? (${CLR_GREEN}y${CLR_RESET}/${CLR_RED}n${CLR_RESET}): "
        read -r REPLY
        echo

        case "$REPLY" in
            [Yy]*) ;;
            *)
                echo "Installation cancelled."
                exit 0
                ;;
        esac
    fi

    for spec in $resolved; do
        pkg="${spec%%::*}"
        repo="${spec##*::}"

        if prepare_build_script "$pkg" "$repo"; then
            work_dir="${CACHE_BASE_DIR}/${repo}/${pkg}"
            script_file="${work_dir}/mspm-build"
            
            version=""
            depends=""
            . "$script_file"
            set +e
            
            if ! check_dependencies; then
                exit 1
            fi
            
            if is_function install; then
                printf "%b\n" "Executing install function for ${CLR_CYAN}${pkg}${CLR_RESET}${CLR_YELLOW}::${repo}${CLR_RESET}..."
                ( set -e; install )
                if [ $? -eq 0 ]; then
                    register_package "$pkg" "$repo" "$version"
                    printf "%b\n" "${CLR_GREEN}Successfully installed ${CLR_CYAN}${pkg}${CLR_RESET}${CLR_YELLOW}::${repo}${CLR_RESET}"
                else
                    printf "%b\n" "${CLR_RED}Install function failed for ${CLR_CYAN}${pkg}${CLR_RESET}${CLR_YELLOW}::${repo}${CLR_RESET}"
                    exit 1
                fi
            else
                printf "%b\n" "${CLR_RED}Error: 'install' function not found in build script.${CLR_RESET}"
                exit 1
            fi
        else
            exit 1
        fi
    done
}

process_remove_list() {
    resolved=""

    for item in "$@"; do
        case "$item" in
            *::*)
                pkg_name="${item%%::*}"
                full_spec=$(get_installed_package_entry "$pkg_name")
                ;;
            *)
                full_spec=$(get_installed_package_entry "$item")
                ;;
        esac

        if [ -z "$full_spec" ]; then
            printf "%b\n" "${CLR_RED}Package ${CLR_CYAN}$item${CLR_RED} is not installed, cannot remove.${CLR_RESET}"
            exit 1
        fi

        resolved="${resolved}${resolved:+ }${full_spec}"
    done

    printf "%b\n" "Packages to remove:"
    for spec in $resolved; do
        pkg="${spec%%::*}"
        rest="${spec#*::}"
        repo="${rest%%::*}"
        ver="${rest#*::}"
        printf "%b\n" "  - ${CLR_CYAN}${pkg}${CLR_RESET}${CLR_YELLOW}::${repo}${CLR_RESET} ${CLR_BLUE}(version: ${ver:-unknown})${CLR_RESET}"
    done
    echo

    printf "%b" "Proceed with removal? (${CLR_GREEN}y${CLR_RESET}/${CLR_RED}n${CLR_RESET}): "
    read -r REPLY
    echo

    case "$REPLY" in
        [Yy]*) ;;
        *)
            echo "Removal cancelled."
            exit 0
            ;;
    esac

    for spec in $resolved; do
        pkg="${spec%%::*}"
        rest="${spec#*::}"
        repo="${rest%%::*}"
        ver="${rest#*::}"

        if prepare_build_script "$pkg" "$repo"; then
            work_dir="${CACHE_BASE_DIR}/${repo}/${pkg}"
            script_file="${work_dir}/mspm-build"
            
            . "$script_file"
            set +e
            
            if is_function remove; then
                printf "%b\n" "Executing remove function for ${CLR_CYAN}${pkg}${CLR_RESET}${CLR_YELLOW}::${repo}${CLR_RESET}..."
                ( set -e; remove )
                if [ $? -eq 0 ]; then
                    unregister_package "$pkg"
                    cd /tmp || exit 1
                    rm -rf "$work_dir"
                    printf "%b\n" "${CLR_GREEN}Successfully removed ${CLR_CYAN}${pkg}${CLR_RESET}${CLR_YELLOW}::${repo}${CLR_RESET}"
                else
                    printf "%b\n" "${CLR_RED}Remove function failed for ${CLR_CYAN}${pkg}${CLR_RESET}${CLR_YELLOW}::${repo}${CLR_RESET}"
                    exit 1
                fi
            else
                printf "%b\n" "${CLR_RED}Error: 'remove' function not found in build script.${CLR_RESET}"
                exit 1
            fi
        else
            exit 1
        fi
    done
}

process_update() {
    if [ ! -f "$INSTALLED_FILE" ]; then
        printf "%b\n" "${CLR_YELLOW}No installed packages found.${CLR_RESET}"
        return 0
    fi

    updates=""

    while IFS= read -r entry || [ -n "$entry" ]; do
        [ -z "$entry" ] && continue
        pkg="${entry%%::*}"
        rest="${entry#*::}"
        repo="${rest%%::*}"
        inst_ver="${rest#*::}"

        repo_ver=$(get_repo_version "$pkg" "$repo")

        if [ -n "$repo_ver" ] && [ "$inst_ver" != "$repo_ver" ]; then
            updates="${updates}${updates:+ }${pkg}::${repo}::${inst_ver:-unknown}::${repo_ver}"
        fi
    done < "$INSTALLED_FILE"

    if [ -z "$updates" ]; then
        printf "%b\n" "${CLR_GREEN}All packages are up to date.${CLR_RESET}"
        return 0
    fi

    printf "%b\n" "Available updates:"
    for item in $updates; do
        pkg="${item%%::*}"
        rest="${item#*::}"
        repo="${rest%%::*}"
        rest="${rest#*::}"
        old_v="${rest%%::*}"
        new_v="${rest#*::}"

        printf "%b\n" "  - ${CLR_CYAN}${pkg}${CLR_RESET}${CLR_YELLOW}::${repo}${CLR_RESET} [${CLR_RED}${old_v}${CLR_RESET} -> ${CLR_GREEN}${new_v}${CLR_RESET}]"
    done
    echo

    printf "%b" "Proceed with update? (${CLR_GREEN}y${CLR_RESET}/${CLR_RED}n${CLR_RESET}): "
    read -r REPLY
    echo

    case "$REPLY" in
        [Yy]*) ;;
        *)
            echo "Update cancelled."
            exit 0
            ;;
    esac

    SKIP_CONFIRM=1
    for item in $updates; do
        pkg="${item%%::*}"
        rest="${item#*::}"
        repo="${rest%%::*}"
        
        printf "%b\n" "Updating ${CLR_CYAN}${pkg}${CLR_RESET}${CLR_YELLOW}::${repo}${CLR_RESET}..."
        process_install_list "${pkg}::${repo}"
    done
    unset SKIP_CONFIRM
}

process_search() {
    query="$1"
    found=0

    for repo in $(get_ordered_repos); do
        [ -z "$repo" ] && continue
        repo_dir="${REPOS_BASE_DIR}/${repo}"
        
        if [ -d "$repo_dir" ]; then
            for script_path in $(find "$repo_dir" -mindepth 2 -maxdepth 2 -name "mspm-build" 2>/dev/null); do
                [ -z "$script_path" ] && continue
                pkg_dir=$(dirname "$script_path")
                pkg_name=$(basename "$pkg_dir")

                pkg_lower=$(echo "$pkg_name" | tr '[:upper:]' '[:lower:]')
                query_lower=$(echo "$query" | tr '[:upper:]' '[:lower:]')

                match=0
                if [ -z "$query" ]; then
                    match=1
                else
                    case "$pkg_lower" in
                        *"$query_lower"*) match=1 ;;
                    esac
                fi

                if [ $match -eq 1 ]; then
                    ver=$(get_repo_version "$pkg_name" "$repo")
                    installed_mark=""
                    
                    if is_package_installed "$pkg_name"; then
                        installed_mark=" ${CLR_GREEN}[installed]${CLR_RESET}"
                    fi
                    
                    printf "%b\n" "* ${CLR_CYAN}${pkg_name}${CLR_RESET}${CLR_YELLOW}::${repo}${CLR_RESET} ${CLR_BLUE}(version: ${ver:-unknown})${CLR_RESET}${installed_mark}"
                    found=1
                fi
            done
        fi
    done

    if [ $found -eq 0 ]; then
        if [ -n "$query" ]; then
            printf "%b\n" "${CLR_YELLOW}No packages matching '${query}' found.${CLR_RESET}"
        else
            printf "%b\n" "${CLR_YELLOW}No packages available in repositories.${CLR_RESET}"
        fi
    fi
}

process_list() {
    if [ ! -f "$INSTALLED_FILE" ] || [ ! -s "$INSTALLED_FILE" ]; then
        printf "%b\n" "${CLR_YELLOW}No installed packages.${CLR_RESET}"
        return 0
    fi

    printf "%b\n" "Installed packages:"
    while IFS= read -r entry || [ -n "$entry" ]; do
        [ -z "$entry" ] && continue
        pkg="${entry%%::*}"
        rest="${entry#*::}"
        repo="${rest%%::*}"
        ver="${rest#*::}"

        printf "%b\n" "  - ${CLR_CYAN}${pkg}${CLR_RESET}${CLR_YELLOW}::${repo}${CLR_RESET} ${CLR_BLUE}(version: ${ver:-unknown})${CLR_RESET}"
    done < "$INSTALLED_FILE"
}

load_make_conf

ACTION="$1"
shift 2>/dev/null

case "$ACTION" in
    sync)
        sync_repo
        ;;
    install)
        if [ $# -eq 0 ]; then
            echo "Usage: mspm install <pkg-1>[::repo]..."
            exit 1
        fi
        if [ ! -d "$REPOS_BASE_DIR" ]; then
            printf "%b\n" "${CLR_RED}Repositories directory not found at ${REPOS_BASE_DIR}. Run 'mspm sync' first.${CLR_RESET}"
            exit 1
        fi
        process_install_list "$@"
        ;;
    remove)
        if [ $# -eq 0 ]; then
            echo "Usage: mspm remove <pkg-1>[::repo]..."
            exit 1
        fi
        if [ ! -d "$REPOS_BASE_DIR" ]; then
            printf "%b\n" "${CLR_RED}Repositories directory not found at ${REPOS_BASE_DIR}. Run 'mspm sync' first.${CLR_RESET}"
            exit 1
        fi
        process_remove_list "$@"
        ;;
    update)
        if [ ! -d "$REPOS_BASE_DIR" ]; then
            printf "%b\n" "${CLR_RED}Repositories directory not found at ${REPOS_BASE_DIR}. Run 'mspm sync' first.${CLR_RESET}"
            exit 1
        fi
        process_update
        ;;
    search)
        if [ ! -d "$REPOS_BASE_DIR" ]; then
            printf "%b\n" "${CLR_RED}Repositories directory not found at ${REPOS_BASE_DIR}. Run 'mspm sync' first.${CLR_RESET}"
            exit 1
        fi
        process_search "$1"
        ;;
    list)
        process_list
        ;;
    *)
        echo "Usage: mspm sync | install <pkg-1>[::repo]... | remove <pkg-1>[::repo]... | update | search [query] | list"
        exit 1
        ;;
esac

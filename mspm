#!/bin/bash

REPO_DIR="/etc/mspm/mspm-repo"
REPO_GIT_URL="https://github.com/Nick-cpp/mspm-repo.git"
CACHE_BASE_DIR="/etc/mspm/cache"
INSTALLED_FILE="/etc/mspm/installed"
MAKECONF_FILE="/etc/mspm/make.conf"

load_make_conf() {
    if [ -f "$MAKECONF_FILE" ]; then
        set -a
        source "$MAKECONF_FILE"
        set +a

        if [ -n "$MAKEOPTS" ]; then
            export MAKEFLAGS="$MAKEOPTS $MAKEFLAGS"
        fi
    fi
}

check_package_exists() {
    local package="$1"
    [ -f "${REPO_DIR}/${package}/mspm-build" ]
}

is_package_installed() {
    local package="$1"
    [ -f "$INSTALLED_FILE" ] && grep -qx "$package" "$INSTALLED_FILE"
}

register_package() {
    local package="$1"
    mkdir -p "$(dirname "$INSTALLED_FILE")"
    touch "$INSTALLED_FILE"
    if ! grep -qx "$package" "$INSTALLED_FILE"; then
        echo "$package" >> "$INSTALLED_FILE"
    fi
}

unregister_package() {
    local package="$1"
    if [ -f "$INSTALLED_FILE" ]; then
        sed -i "/^${package}$/d" "$INSTALLED_FILE"
    fi
}

check_dependencies() {
    local missing=()
    
    if declare -p depends &> /dev/null && [ ${#depends[@]} -gt 0 ]; then
        for dep in "${depends[@]}"; do
            if [ -n "$dep" ]; then
                if ! is_package_installed "$dep"; then
                    missing+=("$dep")
                fi
            fi
        done
    fi

    if [ ${#missing[@]} -gt 0 ]; then
        echo "Error: missing dependencies: ${missing[*]}"
        return 1
    fi

    return 0
}

prepare_build_script() {
    local package="$1"
    local work_dir="${CACHE_BASE_DIR}/${package}"
    local repo_script="${REPO_DIR}/${package}/mspm-build"
    local target_script="${work_dir}/mspm-build"
    
    if [ ! -f "$repo_script" ]; then
        echo "Error: build script for ${package} not found in repository."
        return 1
    fi

    mkdir -p "$work_dir"
    cp "$repo_script" "$target_script"
    cd "$work_dir" || exit 1
    return 0
}

sync_repo() {
    if ! command -v git &> /dev/null; then
        echo "Error: git is required for sync but not installed."
        exit 1
    fi

    echo "Synchronizing repository..."
    if [ -d "$REPO_DIR" ]; then
        rm -rf "$REPO_DIR"
    fi

    mkdir -p "$(dirname "$REPO_DIR")"
    if git clone "$REPO_GIT_URL" "$REPO_DIR"; then
        echo "Repository successfully synchronized to ${REPO_DIR}"
    else
        echo "Error: failed to clone repository."
        exit 1
    fi
}

load_make_conf

ACTION="$1"
PACKAGE="$2"

if [ "$ACTION" = "sync" ]; then
    sync_repo
    exit 0

elif [ "$ACTION" = "install" ] && [ -n "$PACKAGE" ]; then
    if [ ! -d "$REPO_DIR" ]; then
        echo "Repository not found at ${REPO_DIR}. Run 'mspm sync' first."
        exit 1
    fi

    if check_package_exists "$PACKAGE"; then
        echo "Package found: $PACKAGE"
        read -p "Install? (y/n): " -n 1 -r
        echo
        
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            if prepare_build_script "$PACKAGE"; then
                WORK_DIR="${CACHE_BASE_DIR}/${PACKAGE}"
                SCRIPT_FILE="${WORK_DIR}/mspm-build"
                
                source "$SCRIPT_FILE"
                
                if ! check_dependencies; then
                    exit 1
                fi
                
                if declare -f install &> /dev/null; then
                    echo "Executing install function for ${PACKAGE}..."
                    if install; then
                        register_package "$PACKAGE"
                        echo "Successfully installed ${PACKAGE}"
                    else
                        echo "Install function failed for ${PACKAGE}"
                        exit 1
                    fi
                else
                    echo "Error: 'install' function not found in build script."
                    exit 1
                fi
            else
                exit 1
            fi
        else
            echo "Installation cancelled."
            exit 0
        fi
    else
        echo "Package not found in repository: $PACKAGE"
        exit 1
    fi

elif [ "$ACTION" = "remove" ] && [ -n "$PACKAGE" ]; then
    if [ ! -d "$REPO_DIR" ]; then
        echo "Repository not found at ${REPO_DIR}. Run 'mspm sync' first."
        exit 1
    fi

    if ! is_package_installed "$PACKAGE"; then
        echo "Package $PACKAGE is not installed, cannot remove."
        exit 1
    fi

    if check_package_exists "$PACKAGE"; then
        echo "Package found: $PACKAGE"
        read -p "Remove? (y/n): " -n 1 -r
        echo
        
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            if prepare_build_script "$PACKAGE"; then
                WORK_DIR="${CACHE_BASE_DIR}/${PACKAGE}"
                SCRIPT_FILE="${WORK_DIR}/mspm-dir"
                SCRIPT_FILE="${WORK_DIR}/mspm-build"
                
                source "$SCRIPT_FILE"
                
                if declare -f remove &> /dev/null; then
                    echo "Executing remove function for ${PACKAGE}..."
                    if remove; then
                        unregister_package "$PACKAGE"
                        echo "Successfully removed ${PACKAGE}"
                    else
                        echo "Remove function failed for ${PACKAGE}"
                        exit 1
                    fi
                else
                    echo "Error: 'remove' function not found in build script."
                    exit 1
                fi
            else
                exit 1
            fi
        else
            echo "Removal cancelled."
            exit 0
        fi
    else
        echo "Package not found in repository: $PACKAGE"
        exit 1
    fi

else
    echo "Usage: mspm sync | install <package-name> | remove <package-name>"
    exit 1
fi
